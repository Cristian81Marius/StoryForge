# --- Bază de date ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/storyforge"

# --- Criptare token-uri integrări (AES-256-GCM) ---
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
STORYFORGE_ENC_KEY=""

# --- Autentificare admin (un singur utilizator) ---
ADMIN_USER="admin"
# Hash bcrypt (nu parola): npm run -s hash-password -w @storyforge/web -- 'parola-ta'
ADMIN_PASSWORD_HASH=""
# Secret pentru cookie-ul de sesiune (min. 32 caractere aleatoare)
SESSION_SECRET=""

# --- Storage pentru video/audio/imagini ---
# local (implicit): fișierele stau în STORAGE_DIR pe calculatorul cu workerul și aplicația web
# s3: orice storage S3-compatibil (AWS S3, Cloudflare R2, MinIO) cu variabilele S3_* de mai jos
STORAGE_DRIVER="local"
STORAGE_DIR="./storage"
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET="storyforge"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="true"

# --- Worker ---
WORKER_ID="worker-1"
WORKER_POLL_MS="5000"
# Calea către executabilul claude (implicit din PATH)
CLAUDE_BIN="claude"
# Autentificare abonament pentru rulări fără browser: `claude setup-token`
# (se setează în mediul serviciului, NU aici, dacă nu vrei token în fișier)
# CLAUDE_CODE_OAUTH_TOKEN=""
# Director de lucru pentru episoade (motorul v2 + output)
WORK_DIR="./work"
# Python pentru motorul v2 (build_v2.py): implicit python3 (Linux/macOS) sau python (Windows)
# PYTHON_BIN="python"
# Procese paralele de randare (skill: mașina are două nuclee → 2)
RENDER_WORKERS="2"
# Linkurile din emailuri (adresa aplicației web)
APP_URL="http://localhost:3000"
# Numele serverului MCP Metricool în Claude Code (modul „mcp”)
# METRICOOL_MCP_SERVER="metricool"
# 0 = oprește sarcinile programate din worker (ritm săptămânal, notificări)
WORKER_CRON="1"
# 1 = agenți simulați cu fixture (demo/teste, fără consum din abonament)
STORYFORGE_MOCK_AGENTS="0"
